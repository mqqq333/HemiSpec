include LICENSE
include README.md
include pyproject.toml
include src/hemispec/py.typed
recursive-include src/hemispec/resources *.sh
include src/hemispec/resources/gui/hemispec.png
include src/hemispec/resources/gui/hemispec.ico
include src/hemispec/resources/gui/hemispec_mark_*.png
include docs/assets/images/hemispec-logo.svg
include docs/assets/images/hemispec-logo-wordmark.svg

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store

prune assets
prune build
prune dist
prune data
prune outputs
prune reference
prune ref_paper
prune p2a-session
